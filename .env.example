# Copy this file to .env.local for local work.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# ---- Clerk: sign-in for the admin -------------------------------
# From https://dashboard.clerk.com -> your app -> API Keys.
# Paste the whole key in place of the angle brackets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# ---- Who may manage the collection ------------------------------
# Exactly one address. Only the person signed in with this email can
# reach /admin or change anything. The password is NOT set here and
# must never be put in this file or in the code: Clerk holds it.
ADMIN_EMAIL=<the-admin-email-address>

# ---- Vercel Blob: where products and photos are stored ----------
# Vercel dashboard -> Storage -> create a Blob store -> connect it to
# this project. Vercel then sets this for you on the deployed site;
# copy it here only for local work.
BLOB_READ_WRITE_TOKEN=<your-vercel-blob-token>
